#version 450
// Spektrafilm for Android — GPU device probe: PRINTING per-pixel kernel (#147 M2). GPLv3.
// Film modeling powered by spektrafilm.
//
// PROBE-ONLY shader (lives under tools/, not engine/): fp32 port of the printing
// stage's per-pixel chain under the parity-golden toggles (enlarger LUT off,
// preflash off, diffusion off, morph off):
//
//   runtime/stages/printing.cpp::print_expose (direct path)
//     raw[k] = sum_l 10^-(cmy·dye_l) * isens[l,k]   (81-band spectral integral;
//       isens folds 10^-base * dichroic-filtered enlarger illuminant * print
//       sensitivity, NaN bands zeroed — the engine's light = NaN -> 0 semantics)
//     raw = raw * midgray + preflash
//     lr  = log10(max(raw,0)+1e-10)
//     r   = 10^lr * (print_exposure * bw)      (the engine's verbatim round trip)
//     lr2 = log10(max(r,0)+1e-10)
//   runtime/stages/printing.cpp::print_develop (develop_simple)
//     density = fast_interp(lr2, paper log_exposure/gamma, RAW paper curves)
//
// Tables folded on the host via the engine's own loaders/digest (profiles/,
// runtime/params, runtime/print_digest); the f64 CPU reference
// (ref_printing_f64.cpp) mirrors THIS shader 1:1 on the same fp32 tables.
// No NaN guard on the input (same as the scan kernel): NaN density is recorded
// as raw device behaviour by the probe.
#define NB 81
#define WG 64
layout(local_size_x = WG) in;

layout(std430, binding = 0) readonly  buffer InBuf      { float cmy[];         };  // npix*3 film density CMY
layout(std430, binding = 1) writeonly buffer OutBuf     { float dens[];        };  // npix*3 print density CMY
layout(std430, binding = 2) readonly  buffer Dye        { float dye[];         };  // NB*3 film channel_density (NaN bands zeroed)
layout(std430, binding = 3) readonly  buffer ISens      { float isens[];       };  // NB*3 10^-base * filtered_illum * print_sens
layout(std430, binding = 4) readonly  buffer PaperAxis  { float paper_axis[];  };  // n*3 paper log_exposure/gamma
layout(std430, binding = 5) readonly  buffer PaperCurve { float paper_curve[]; };  // n*3 RAW paper density curves
layout(push_constant) uniform Push {
    uint  npix;
    int   n;        // paper density-curve points
    float midgray;  // exposure_factor_midgray
    float mult;     // print_exposure * bw_exposure_correction
    float pf0, pf1, pf2;  // constant preflash raw (0 under goldens)
} pc;

float log10f(float v) { return log2(v) * 0.30102999566398119521; }

// fast_interp (kernels/interp.cpp), channel-specific axis; see filming.comp.
float interp_paper(float x, int c) {
    int n = pc.n;
    float x0 = paper_axis[c], xN = paper_axis[(n - 1) * 3 + c];
    if (x <= x0) return paper_curve[c];
    if (x >= xN) return paper_curve[(n - 1) * 3 + c];
    int low = n - 2;
    for (int k = 1; k < n; ++k) { if (x < paper_axis[k * 3 + c]) { low = k - 1; break; } }
    float xl = paper_axis[low * 3 + c], xh = paper_axis[(low + 1) * 3 + c];
    float dx = xh - xl;
    float t = (dx != 0.0) ? (x - xl) / dx : 0.0;
    float y0 = paper_curve[low * 3 + c], y1 = paper_curve[(low + 1) * 3 + c];
    return y0 + t * (y1 - y0);
}

void main() {
    uint p = gl_GlobalInvocationID.x;
    if (p >= pc.npix) return;
    float c0 = cmy[p * 3u + 0u], c1 = cmy[p * 3u + 1u], c2 = cmy[p * 3u + 2u];

    // 81-band spectral integral: transmittance through the negative's dyes into
    // the (base+illuminant+sensitivity)-folded table.
    float R0 = 0.0, R1 = 0.0, R2 = 0.0;
    for (int l = 0; l < NB; ++l) {
        float D = c0 * dye[l * 3 + 0] + c1 * dye[l * 3 + 1] + c2 * dye[l * 3 + 2];
        float T = pow(10.0, -D);
        R0 += T * isens[l * 3 + 0];
        R1 += T * isens[l * 3 + 1];
        R2 += T * isens[l * 3 + 2];
    }
    R0 = R0 * pc.midgray + pc.pf0;
    R1 = R1 * pc.midgray + pc.pf1;
    R2 = R2 * pc.midgray + pc.pf2;

    // _film_cmy_to_print_log_raw tail + expose()'s 10^/log10 round trip.
    float lr0 = log10f(max(R0, 0.0) + 1e-10);
    float lr1 = log10f(max(R1, 0.0) + 1e-10);
    float lr2 = log10f(max(R2, 0.0) + 1e-10);
    float r0 = pow(10.0, lr0) * pc.mult;
    float r1 = pow(10.0, lr1) * pc.mult;
    float r2 = pow(10.0, lr2) * pc.mult;
    lr0 = log10f(max(r0, 0.0) + 1e-10);
    lr1 = log10f(max(r1, 0.0) + 1e-10);
    lr2 = log10f(max(r2, 0.0) + 1e-10);

    // print_develop (develop_simple): raw paper curves, gamma folded into the axis.
    dens[p * 3u + 0u] = interp_paper(lr0, 0);
    dens[p * 3u + 1u] = interp_paper(lr1, 1);
    dens[p * 3u + 2u] = interp_paper(lr2, 2);
}
